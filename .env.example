OPENAI_API_KEY=your_openai_api_key
CHATGPT_API_KEY=${OPENAI_API_KEY}
OPENAI_MODEL=gpt-4o-mini
USE_HELPER_MODEL=0
USE_KNOWLEDGE_TREE=1
RESET_SESSION_FILES=1
USE_SAFETY_CHECK=1
MEMORY_SUMMARY_THRESHOLD_CHARS=12000
TREATMENT_MIN_CONTEXT_TURNS=3
CLINICAL_SKILL_ID=ocd_erp
CLINICAL_SKILL_VERSION=1.0.0
# Optional: deliver high/critical risk alerts to a clinician-owned endpoint.
# Alerts are always persisted locally even when no webhook is configured.
# CLINICAL_ALERT_WEBHOOK_URL=https://example.org/clinical-alerts
# Optional: override the crisis resources shown in a crisis-response message.
# SAFETY_CRISIS_RESOURCES=If you are in immediate danger, call ...
